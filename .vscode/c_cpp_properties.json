{
    "configurations": [
        {
            "name": "Win64", 
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include", 
                "/usr/local/include",
                "/usr/include/c++/14",
                "${workspaceFolder}",
                "${workspaceFolder}/component",
                "${workspaceFolder}/control",
                "${workspaceFolder}/share"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}